{
	"info": {
		"_postman_id": "stellar-measurements-lr4-collection",
		"name": "Stellar Measurements - Лабораторная 4 (JWT & Swagger & Redis)",
		"description": "Коллекция запросов для демонстрации ЛР4 по теме 'Определение расстояния до звезды в Млечном пути по ее годовому параллаксу': аутентификация по JWT, черный список токенов в Redis, ролевая модель и автозаполнение создателя.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "starId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. POST Регистрация нового пользователя",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"login\": \"astronomer_alex\",\n    \"password\": \"stellarPass2026!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"register"
					]
				},
				"description": "Регистрация нового пользователя в системе с валидацией уникальности логина, хэшированием пароля SHA-1 и назначением роли Astronomer."
			},
			"response": []
		},
		{
			"name": "2. POST Аутентификация пользователя (получение JWT)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.access_token) {",
							"    pm.collectionVariables.set(\"token\", jsonData.access_token);",
							"    console.log(\"Saved JWT access token to collection variable\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"login\": \"user1\",\n    \"password\": \"password1\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"login"
					]
				},
				"description": "Аутентификация пользователя. Возвращает JWT токен и выставляет cookie. Токен автоматически сохраняется в переменную {{token}}."
			},
			"response": []
		},
		{
			"name": "3. GET Список всех опубликованных звезд (независимо от токена)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars?distance=50",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars"
					],
					"query": [
						{
							"key": "distance",
							"value": "50",
							"description": "Максимальное расстояние до звезды (в парсеках)"
						}
					]
				},
				"description": "Получение списка опубликованных звезд с серверной фильтрацией по расстоянию. Работает независимо от наличия токена/куки."
			},
			"response": []
		},
		{
			"name": "4. GET Лента опубликованных звезд (is_liked)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/feed?id=1&next=true",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"feed"
					],
					"query": [
						{
							"key": "id",
							"value": "1"
						},
						{
							"key": "next",
							"value": "true"
						}
					]
				},
				"description": "Лента опубликованных звезд. Для авторизованного пользователя вычисляется персональный признак is_liked."
			},
			"response": []
		},
		{
			"name": "5. GET Черновик текущего пользователя (JWT)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/draft",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"draft"
					]
				},
				"description": "Получение единственного черновика текущего пользователя (синглтон). Требует валидный JWT токен."
			},
			"response": []
		},
		{
			"name": "6. POST Добавление новой звезды в черновик (JWT, MinIO)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "name",
							"value": "Денеб",
							"type": "text"
						},
						{
							"key": "description",
							"value": "Белый сверхгигант в созвездии Лебедя, спектральный класс A2Ia.",
							"type": "text"
						},
						{
							"key": "parallax",
							"value": "0.002",
							"type": "text"
						},
						{
							"key": "distance",
							"value": "500.00",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars"
					]
				},
				"description": "Создание услуги в статусе draft с автозаполнением создателя из JWT токена."
			},
			"response": []
		},
		{
			"name": "7a. PUT Публикация звезды гостем (проверка 401 Unauthorized)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"description\": \"Попытка публикации без авторизации\",\n    \"parallax\": 0.130,\n    \"distance\": 7.68\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/4/publish",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"4",
						"publish"
					]
				},
				"description": "Демонстрация защиты API: для неавторизованного гостя возвращается 401 Unauthorized."
			},
			"response": []
		},
		{
			"name": "7b. PUT Публикация звезды авторизованным создателем (200 OK)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"description\": \"Ярчайшая звезда созвездия Лиры, вершина Летнего треугольника.\",\n    \"parallax\": 0.130,\n    \"distance\": 7.68\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/4/publish",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"4",
						"publish"
					]
				},
				"description": "Успешная публикация черновика авторизованным создателем: смена статуса на published, обновление полей."
			},
			"response": []
		},
		{
			"name": "8. POST Поставить / отменить лайк (JWT)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"like\": 1\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/2/like",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"2",
						"like"
					]
				},
				"description": "Установка или снятие лайка от лица авторизованного пользователя."
			},
			"response": []
		},
		{
			"name": "9. DELETE Логическое удаление звезды создателем (JWT)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/3",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"3"
					]
				},
				"description": "Логическое удаление услуги (soft delete) создателем."
			},
			"response": []
		},
		{
			"name": "10. POST Деавторизация пользователя (Redis blacklist)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/users/logout",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"logout"
					]
				},
				"description": "Деавторизация: текущий JWT токен заносится в черный список Redis на время оставшейся жизни."
			},
			"response": []
		},
		{
			"name": "11. GET Проверка отозванного токена после logout (401 Unauthorized)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/parallax_stars/draft",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"parallax_stars",
						"draft"
					]
				},
				"description": "Проверка работы blacklist Redis: запрос с отозванным токеном возвращает 401 Unauthorized."
			},
			"response": []
		}
	]
}
